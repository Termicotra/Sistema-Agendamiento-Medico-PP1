# ========================================
# VARIABLES DE ENTORNO PARA RAILWAY
# ========================================

# IMPORTANTE: Generar un nuevo SECRET_KEY para producción
# Puedes usar: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=tu-secret-key-aqui-generar-nueva

# Configuración de producción
DEBUG=False
ALLOWED_HOSTS=tu-app.railway.app,tu-dominio.com

# Base de datos (Railway provee DATABASE_URL automáticamente)
# No necesitas configurar DB_NAME, DB_USER, etc. si usas DATABASE_URL
DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS - URLs del frontend permitidas (separadas por comas)
CORS_ALLOWED_ORIGINS=https://agendamientomedico.netlify.app,https://tu-dominio.com

# Seguridad para producción (debe ser True en Railway)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ========================================
# VARIABLES OPCIONALES PARA DESARROLLO LOCAL
# ========================================

# Si no usas DATABASE_URL, puedes usar estas variables individuales:
# DB_NAME=agenmeddb
# DB_USER=master
# DB_PASSWORD=admin
# DB_HOST=localhost
# DB_PORT=5432
